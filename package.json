{
  "name": "wmcc-site",
  "private": true,
  "version": "1.0.0",
  "description": "Website for the Windham Muslim Community Center (wmccmosque.org)",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "build:preview": "vite build --mode preview",
    "check:masjidal": "node server/check-masjidal.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "express": "4.22.3",
    "framer-motion": "11.11.17",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.11.0",
    "prettier": "3.3.3",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "2.3.4"
  }
}
